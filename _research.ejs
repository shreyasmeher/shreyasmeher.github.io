```{=html}
<%
const SECTIONS = [
  ["publications", "Publications"],
  ["proceedings", "Conference proceedings"],
  ["review", "Under review"],
  ["working", "Working papers"],
  ["dissertation", "Dissertation"]
];
// Keep the anchors of the old hand-written page working.
const IDS = { publications: "publications", proceedings: "conference-proceedings", review: "under-review", working: "working-papers", dissertation: "dissertation" };
const STATUS = { published: "Published", forthcoming: "Forthcoming", conditional: "Conditionally accepted", rr: "Revise & resubmit", review: "Under review", working: "Working paper", thesis: "Dissertation" };
const esc = s => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

for (const [key, heading] of SECTIONS) {
  const entries = items.filter(i => i.section === key);
  if (!entries.length) continue;
  print(`<section class="pub-section" id="${IDS[key]}" data-section>\n<h2>${esc(heading)}</h2>\n`);
  for (const p of entries) {
    const title = p.doi ? `<a href="https://doi.org/${esc(p.doi)}">${esc(p.title)}</a>` : esc(p.title);
    const meta = [];
    if (p.with) meta.push(esc(p.with));
    if (p.venue) meta.push(`<i>${esc(p.venue)}</i>`);
    if (p.year) meta.push(esc(p.year));
    const links = [];
    if (p.doi) links.push(`<a href="https://doi.org/${esc(p.doi)}">Article</a>`);
    for (const l of (p.links || [])) links.push(`<a href="${esc(l.href)}">${esc(l.text)}</a>`);
    if (p.bibtex) links.push(`<button type="button" class="linkish cite-btn" hidden>Copy citation</button>`);
    links.push(`<a class="copy-link" href="#${esc(p.slug)}" aria-label="Copy a link to this paper: ${esc(p.title)}">Copy link</a>`);
    print(`<article class="pub" id="${esc(p.slug)}" data-status="${esc(p.status)}" data-topics="${esc((p.topics || []).join(" "))}">\n`);
    print(`<h3 class="pub-title">${title}</h3>\n`);
    print(`<div class="pub-row"><span class="status ${esc(p.status)}">${esc(STATUS[p.status])}</span><span class="pub-venue">${meta.join(", ")}</span></div>\n`);
    print(`<div class="pub-links">${links.join("")}</div>\n`);
    if (p.bibtex) print(`<pre class="bibtex" hidden>${esc(p.bibtex.trim())}</pre>\n`);
    print(`<p class="pub-toast" role="status" aria-live="polite"></p>\n`);
    // abstract is trusted HTML from papers.yml
    if (p.abstract) print(`<details class="abstract"><summary><span>Abstract</span></summary><p>${p.abstract}</p></details>\n`);
    print(`</article>\n`);
  }
  print(`</section>\n`);
}
%>
```
